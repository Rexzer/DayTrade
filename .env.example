# =============================================================================
# XAUUSD Trading Platform — Example Environment Configuration (Phase 1)
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. NEVER put secrets in source code.
#
# Phase 1 is ANALYSIS-ONLY. There are NO broker credentials here on purpose:
# live trading / MetaTrader integration is implemented in later phases.
# =============================================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
APP_NAME=XAUUSD Trading Platform
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Security ----
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ---- Database (PostgreSQL) ----
POSTGRES_USER=xauusd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xauusd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL (overrides the individual POSTGRES_* values if set)
# DATABASE_URL=postgresql+psycopg://xauusd:change-me@localhost:5432/xauusd

# ---- Redis (cache / realtime messaging) ----
REDIS_URL=redis://localhost:6379/0

# ---- Trading safety locks ----
# Automated live trading and live order execution are NOT implemented yet and
# MUST remain false. The application refuses to start if these are true.
ENABLE_PAPER_TRADING=false
ENABLE_LIVE_TRADING=false
LIVE_EXECUTION_ENABLED=false

# ---- MetaTrader 5 (Phase 6, READ-ONLY) ----
# Requires the MT5 terminal + the MetaTrader5 Python package on the backend
# host. The password is read from the environment only and is never logged or
# returned by the API (prefer a secret store in production).
# MT5_LOGIN=
# MT5_SERVER=YourBroker-Demo
# MT5_PASSWORD=
# MT5_PATH=
MT5_SYMBOL=XAUUSD

# ---- Market data ----
# Provider selection:
#   none       -> NullMarketDataProvider (default; fully disconnected, no data)
#   simulated  -> deterministic synthetic feed for OFFLINE DEV ONLY.
#                 Clearly labelled source="simulated"; NOT real market data.
#   rest       -> generic HTTP JSON quote poller (needs network + endpoint/key)
#   mt5        -> MetaTrader 5 (read-only) as the data source (see MT5_* below)
MARKET_DATA_PROVIDER=none
# Broker-specific XAUUSD symbol (e.g. XAUUSD, XAUUSDm, GOLD, XAUUSD.a)
MARKET_DATA_SYMBOL=XAUUSD
# How often the loop pulls a tick (seconds) for polling/simulated providers.
MARKET_TICK_INTERVAL_SECONDS=1.0
# Freshness thresholds driving LIVE/DELAYED/STALE classification.
DATA_DELAYED_AFTER_SECONDS=3.0
DATA_STALE_AFTER_SECONDS=10.0
# Number of historical candles to seed per timeframe on connect.
MARKET_HISTORY_CANDLES=300
# For MARKET_DATA_PROVIDER=rest, supply the quote endpoint + any API key via
# your own wiring/secret store. Never hard-code keys in source.
# MARKET_DATA_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
