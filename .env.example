# =============================================================================
# XAUUSD Trading Platform — Example Environment Configuration (Phase 1)
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. NEVER put secrets in source code.
#
# Phase 1 is ANALYSIS-ONLY. There are NO broker credentials here on purpose:
# live trading / MetaTrader integration is implemented in later phases.
# =============================================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
APP_NAME=XAUUSD Trading Platform
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Security ----
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ---- Database (PostgreSQL) ----
POSTGRES_USER=xauusd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xauusd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL (overrides the individual POSTGRES_* values if set)
# DATABASE_URL=postgresql+psycopg://xauusd:change-me@localhost:5432/xauusd

# ---- Redis (cache / realtime messaging) ----
REDIS_URL=redis://localhost:6379/0

# ---- Trading safety (Phase 1 hard locks) ----
# These MUST remain false in Phase 1. The application refuses to enable them.
ENABLE_PAPER_TRADING=false
ENABLE_LIVE_TRADING=false

# ---- Market data (placeholders — no provider wired up in Phase 1) ----
# MARKET_DATA_PROVIDER=none
# MARKET_DATA_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
